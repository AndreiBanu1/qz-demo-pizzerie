# The one allowed style hash is sha256("text-overflow:inherit"): Safari (WebKit) puts that inline style on every <select>
# internally and reports it as a CSP violation otherwise. Any other inline style stays blocked.
/*
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-hashes' 'sha256-3oFxofzq3N//6J8H86e9ul4WT2OkJrtonB66gn/TLJw='; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# The raw audit files of the report. .json.gz is served as a gzip file to download, so browsers don't unzip it in transit.
/raport/date/*.json.gz
  Content-Type: application/gzip

# The report PDFs open in the browser's built-in viewer, which the page CSP's object-src 'none' can block, so these drop the CSP.
# They are still noindex and carry every other header from /*.
/raport/*.pdf
  ! Content-Security-Policy
